{
  "name": "any-match",
  "description": "Determine if a single match exists with an array of strings, numbers, and/or RegExps.",
  "version": "3.0.1",
  "license": "MIT",
  "author": "Steven Vachon <contact@svachon.com> (https://svachon.com)",
  "repository": "github:stevenvachon/any-match",
  "type": "module",
  "dependencies": {
    "is-regexp": "^3.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "cspell": "^10.0.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "build": "npm run build:spellcheck && npm run build:lint && npm run build:compile",
    "build:compile": "tsc",
    "build:lint": "prettier --check '*.{js,json,md}'",
    "build:spellcheck": "cspell '*.{js,json,md}' --no-progress",
    "prepublishOnly": "npm run build && npm test",
    "test": "npm run test:watch -- --reporter=verbose --run",
    "test:watch": "vitest dev --coverage --coverage.reporter=html --coverage.reporter=lcov --coverage.reporter=text"
  },
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "keywords": [
    "match",
    "regex",
    "regexp"
  ]
}
